<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up only the user's own data (saved places, recent searches, settings).
     The timetable and map copies are left out: the app recreates them from the APK. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="database" path="user.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="transit.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="database" path="user.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="transit.xml" />
    </device-transfer>
</data-extraction-rules>
